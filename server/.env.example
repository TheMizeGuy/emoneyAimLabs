# eMoney Aim Labs API - environment variable NAMES only.
# Real values live in Railway service variables and nowhere else in this repo.
# Copy to .env for local work; .env is gitignored.

# Postgres connection string (Railway Postgres provides this).
DATABASE_URL=postgresql://user:password@host:5432/database

# Twitch application credentials (dev.twitch.tv console).
# The registered OAuth redirect URL must be BASE_URL + /auth/twitch/callback
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret

# Random string, 32 characters minimum. Signs the session and OAuth state
# cookies. Rotating it logs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# Exact origin the game is served from. CORS allows this origin and no other.
GAME_ORIGIN=https://themizeguy.github.io

# Public origin of this API (the Railway domain), no trailing slash.
BASE_URL=https://replace-with-railway-domain

# Optional. Path appended to GAME_ORIGIN when returning from Twitch login.
GAME_RETURN_PATH=/emoneyAimLabs/

# Optional. Fastest Chase time each mode will accept, in milliseconds. The
# engine itself cannot win before its 400 ms arming gate; do not set this lower.
FLOOR_PRACTICE_MS=400
FLOOR_SIM_MS=400

# Optional. Session cookie lifetime in milliseconds (default 30 days).
SESSION_TTL_MS=2592000000

# Optional. OAuth state cookie lifetime in milliseconds (default 10 minutes).
OAUTH_STATE_TTL_MS=600000

# Optional. The build salt the browser signs its win line with. It ships inside
# js/chase.js and is public by design, so this is friction on top of the
# server-witnessed checks, never a secret. Accepts a comma separated list so a
# client salt bump can be rolled out without rejecting in-flight wins.
WIN_SIG_SALT=aimlab-95-v2.7

# Optional. Set to false only if the client and server salts have drifted: the
# signature is then checked for shape but not for value.
WIN_SIG_STRICT=true

# Optional. Railway sets this automatically.
PORT=3000

# Railway platform variable (not read by the Node app). Gives in-flight scores
# time to finish before an old deployment is terminated.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
